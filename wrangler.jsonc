{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gamectl-shop",
  "compatibility_date": "2026-08-01",
  "main": "./workers/canonical-redirect.js",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "gamectl.shop", "custom_domain": true },
    { "pattern": "www.gamectl.shop", "custom_domain": true }
  ]
}
